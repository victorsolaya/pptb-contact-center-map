      "name": "Víctor Sánchez",
      "url": "https://github.com/victorsolaya"
    }
  ],
  "configurations": {
    "repository": "https://github.com/victorsolaya/pptb-contact-center-map",
    "website": "https://github.com/victorsolaya/pptb-contact-center-map",
    "readmeUrl": "https://raw.githubusercontent.com/victorsolaya/pptb-contact-center-map/main/README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsolaya/pptb-contact-center-map.git"
  },
  "bugs": {
    "url": "https://github.com/victorsolaya/pptb-contact-center-map/issues"
  },
  "homepage": "https://github.com/victorsolaya/pptb-contact-center-map#readme",
  "keywords": [
    "powerplatform",
    "dataverse",
    "toolbox",
    "contact center",
    "omnichannel",
