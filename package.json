{
  "name": "@victorsolaya/pptb-contact-center-map",
  "version": "0.3.0",
  "type": "module",
  "displayName": "Contact Center Map",
  "description": "Draw the Dynamics 365 Contact Center configuration: channels, workstreams, routing rules, queues, overflow, operating hours and agents. Export to PNG or Mermaid.",
