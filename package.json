    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
